{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (g++)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "-std=c++20",
                "-Iinclude",
                "-o",
                "greedysnake.exe",
                "src/main.cpp",
                "src/game_shared.cpp",
                "src/game_ui.cpp",
                "src/leaderboard.cpp",
                "src/level1.cpp",
                "src/snake_class.cpp",
                "src/food.cpp",
                "src/player.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}