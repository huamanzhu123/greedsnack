{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (g++)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "-std=c++20",
                "-Iinclude",
                "-o",
                "greedysnake.exe",
                "src/main.cpp",
                "src/game_shared.cpp",
                "src/game_ui.cpp",
                "src/level_common.cpp",
                "src/level1.cpp",
                "src/leaderboard.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$gcc",
            "detail": "Compile all sources with G++ (C++20)"
        },
        {
            "label": "run",
            "type": "shell",
            "command": ".\\greedysnake.exe",
            "dependsOn": [
                "build (g++)"
            ],
            "problemMatcher": [],
            "detail": "Build and run the game"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "del",
                "/q",
                "greedysnake.exe"
            ],
            "problemMatcher": [],
            "detail": "Clean build artifacts"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}